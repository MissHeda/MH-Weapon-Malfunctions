<?xml version="1.0" encoding="utf-8"?>
<Project name="MHWM">
    <Package name="Main">
        <Key ID="STR_mhwm_main_AI">
            <English>AI weapons malfunction</English>
        </Key>
        <Key ID="STR_mhwm_main_AI_Desc">
            <English>AI units clear their weapons by\nthemselves after a few seconds.</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindFix_Desc">
            <English>On: Alt + R clears this malfunction\nblind - the whole drill, in the time\nset above.\n\nOff: Tap-Rack fails on it, the player\nhas to open the 3D view (Shift + R).</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindFix_Double">
            <English>Tap-Rack clears: double feed</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindFix_Dud">
            <English>Tap-Rack clears: dud</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindFix_Extract">
            <English>Tap-Rack clears: stuck case</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindFix_Feed">
            <English>Tap-Rack clears: failure to feed</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindFix_Stovepipe">
            <English>Tap-Rack clears: stovepipe</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindTime_Desc">
            <English>Seconds the blind Tap-Rack takes for\nthis malfunction, when it may clear it.\n\nA weak magazine is swapped too: it\ntakes twice the feed time.</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindTime_Double">
            <English>Tap-Rack time: double feed</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindTime_Dud">
            <English>Tap-Rack time: dud</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindTime_Extract">
            <English>Tap-Rack time: stuck case</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindTime_Feed">
            <English>Tap-Rack time: failure to feed</English>
        </Key>
        <Key ID="STR_mhwm_main_BlindTime_Stovepipe">
            <English>Tap-Rack time: stovepipe</English>
        </Key>
        <Key ID="STR_mhwm_main_Cat_Clearing">
            <English>Clearing</English>
        </Key>
        <Key ID="STR_mhwm_main_Cat_Jamming">
            <English>Jamming</English>
        </Key>
        <Key ID="STR_mhwm_main_Enabled">
            <English>Enable MH Weapon Malfunctions</English>
        </Key>
        <Key ID="STR_mhwm_main_Enabled_Desc">
            <English>Weapons can malfunction and have to be\ncleared by hand.\n\nOff: no new malfunctions, and every\nweapon that is jammed now works again.</English>
        </Key>
        <Key ID="STR_mhwm_main_Handguns">
            <English>Handguns malfunction</English>
        </Key>
        <Key ID="STR_mhwm_main_Handguns_Desc">
            <English>Off: only primary weapons malfunction.</English>
        </Key>
        <Key ID="STR_mhwm_main_HeatFactor">
            <English>Heat factor (ACE)</English>
        </Key>
        <Key ID="STR_mhwm_main_HeatFactor_Desc">
            <English>With ACE Overheating loaded, a hot\nbarrel makes malfunctions likelier.\n\nAt 500 degrees the rate is multiplied\nby 1 + this.\n\n0 = heat does not matter.</English>
        </Key>
        <Key ID="STR_mhwm_main_QuickKeys">
            <English>Allow the blind Tap-Rack</English>
        </Key>
        <Key ID="STR_mhwm_main_QuickKeys_Desc">
            <English>Alt + R clears the weapon blind,\nwithout the 3D view: tap, rack.\n\nOff: every malfunction is cleared in\nthe 3D view (Shift + R).</English>
        </Key>
        <Key ID="STR_mhwm_main_Rate">
            <English>Malfunctions per 1000 rounds</English>
        </Key>
        <Key ID="STR_mhwm_main_Rate_Desc">
            <English>How many malfunctions a weapon has on\naverage in 1000 rounds, before the\nfactors below.\n\n2 = a well kept service rifle.\n0 = never.</English>
        </Key>
        <Key ID="STR_mhwm_main_SubsonicMags">
            <English>More subsonic magazines</English>
        </Key>
        <Key ID="STR_mhwm_main_SubsonicMags_Desc">
            <English>Subsonic rounds in a weapon made for\nfaster ones jam twice as often. They\nare found by themselves.\n\nAdd more magazine classes here,\nseparated by commas.\n\nWildcards work: *_SD_*, rhs_mag_9x39*</English>
        </Key>
        <Key ID="STR_mhwm_main_WeaponRates">
            <English>Weapon reliability</English>
        </Key>
        <Key ID="STR_mhwm_main_WeaponRates_Desc">
            <English>Factors for single weapons, as\nclass:factor, separated by commas.\n\nExample:\narifle_AKM_F:0.3, LMG_03_F:2\n\nWildcards work: rhs_weap_ak*:0.5\nAn exact class wins over a wildcard.\n\n0 = this weapon never jams.\nA weapon's config can set\nmhwm_reliability as well.</English>
        </Key>
    </Package>
</Project>
